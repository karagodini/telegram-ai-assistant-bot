# Получить: https://t.me/BotFather
BOT_TOKEN=123456:ABC-DEF...

# Получить: https://openrouter.ai/keys (подходит free-модель openrouter/free)
OPENROUTER_API_KEY=sk-or-v1-...

# Модель (https://openrouter.ai/models)
MODEL=openrouter/free

# Роль бота
SYSTEM_PROMPT=Ты — вежливый ассистент компании. Отвечай кратко и по делу, на русском языке.

# Ваш Telegram ID (узнать: @userinfobot). Пусто = статистика отключена
ADMIN_ID=

# Антиспам
MAX_REQUESTS_PER_DAY=30

# Параметры индексации
CHUNK_SIZE=500
CHUNK_OVERLAP=100
